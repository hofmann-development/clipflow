#include <windows.h>

#define IDI_APPICON 1
#define TEMPLATE_SINGLE_LINE_DIALOG_ID 101
#define TEMPLATE_MULTILINE_DIALOG_ID 102
#define TEMPLATE_NAME_CONTROL_ID 1101
#define TEMPLATE_VALUE_EDIT_ID 1102

#ifdef FREE_VERSION
    #define CLIPFLOW_PRODUCT_NAME "ClipFlow Free"
#else
    #define CLIPFLOW_PRODUCT_NAME "ClipFlow Pro"
#endif

1 RT_MANIFEST "clipflow.manifest"

IDI_APPICON ICON "clipflow.ico"

TEMPLATE_SINGLE_LINE_DIALOG_ID DIALOGEX 0, 0, 260, 59
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClipFlow"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", TEMPLATE_NAME_CONTROL_ID, 8, 8, 244, 8
    EDITTEXT TEMPLATE_VALUE_EDIT_ID, 8, 24, 244, 9, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 184, 41, 32, 10
    PUSHBUTTON "Cancel", IDCANCEL, 220, 41, 32, 10
END

TEMPLATE_MULTILINE_DIALOG_ID DIALOGEX 0, 0, 260, 158
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClipFlow"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", TEMPLATE_NAME_CONTROL_ID, 8, 8, 244, 8
    EDITTEXT TEMPLATE_VALUE_EDIT_ID, 8, 24, 244, 108,
             ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 184, 140, 32, 10
    PUSHBUTTON "Cancel", IDCANCEL, 220, 140, 32, 10
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stefan Hofmann"
            VALUE "FileDescription", CLIPFLOW_PRODUCT_NAME
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", CLIPFLOW_PRODUCT_NAME
            VALUE "LegalCopyright", "Copyright (C) Stefan Hofmann, 2026"
            VALUE "OriginalFilename", "clipflow.exe"
            VALUE "ProductName", CLIPFLOW_PRODUCT_NAME
            VALUE "ProductVersion", "1.0.0.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
